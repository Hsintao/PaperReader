# Backend runtime
APP_ENV=dev
DATA_DIR=./data
SQLITE_DB_NAME=paperreader.db
CORS_ORIGINS=http://localhost:5173

# DeepSeek API (OpenAI-compatible)
# Apply for a key at https://platform.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# PDF parsing backend: "somark" (cloud API, default) | "mineru" (cloud API)
# | "local" (embedded text layer + images, no extra key)
PDF_PARSER=somark

# SoMark PDF parsing API (used when PDF_PARSER=somark)
# Get a key at https://somark.cn under "API Workbench -> APIKey".
SOMARK_API_KEY=
# Mainland China: https://somark.cn/api/v1 | outside: https://somark.ai/api/v1
SOMARK_BASE_URL=https://somark.cn/api/v1
SOMARK_POLL_INTERVAL=3
SOMARK_TIMEOUT=600

# MinerU PDF parsing API (only used when PDF_PARSER=mineru)
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_POLL_INTERVAL=5
MINERU_TIMEOUT=600

# Layout debugging: also emit outputs/<document_id>/layout-debug.pdf, which
# marks the source page with the block categories the renderer detected.
LAYOUT_DEBUG=false

# Queue
REDIS_URL=redis://localhost:6379/0

# Translation tuning
TRANSLATE_CONCURRENCY=16
TRANSLATE_MAX_RETRIES=5
# Global LLM request rate limit (requests per second). 0 disables limiting.
LLM_RATE_LIMIT_RPS=4
# Max characters joined per IR batch request.
TRANSLATE_BATCH_MAX_CHARS=6000
# Maximum size of one prose segment sent to the model. Keep this below the
# provider's output-token comfort zone so long paragraphs cannot be cut short.
TRANSLATE_SEGMENT_MAX_CHARS=2000
# How often (minutes) the per-domain terminology glossary folds newly learned
# terms into the stored glossary. The translation domain itself is a local
# setting (settings.json), not an environment variable.
GLOSSARY_REFRESH_INTERVAL_MINUTES=30

# Vision-model adversarial check (Phase D). deepseek-flash accepts image input.
VISION_MODEL=deepseek-flash
VISION_CHECK_ENABLED=false
VISION_CHECK_MODE=auto
VISION_CHECK_MAX_PAGES=8

# Frontend
VITE_BACKEND_URL=http://localhost:8000
