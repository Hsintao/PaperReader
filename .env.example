# Backend runtime
APP_ENV=dev
DATA_DIR=./data
SQLITE_DB_NAME=paperreader.db
CORS_ORIGINS=http://localhost:5173

# DeepSeek API (OpenAI-compatible)
# Apply for a key at https://platform.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# PDF translation worker (PDFMathTranslate-next + BabelDOC)
# The backend never imports the translator; it starts it as a separate process.
# Point PDFMATHTRANSLATE_PYTHON at an interpreter that has the worker's
# dependencies (see desktop/requirements-worker.txt). Set
# PDFMATHTRANSLATE_WORKER instead only when the worker is a standalone
# executable; it is used verbatim and receives the job file as its last
# argument. A bare name is looked up on PATH; a path is resolved against the
# repository root, so `worker-runtime/bin/python3` works from any directory.
PDFMATHTRANSLATE_PYTHON=python3
PDFMATHTRANSLATE_WORKER=
# Informational: the version the manifest records as the generator.
PDFMATHTRANSLATE_VERSION=2.9.0
# Seconds a single document may translate for.
PDFMATHTRANSLATE_TIMEOUT=3600
# Scratch space for the translator. Defaults to <DATA_DIR>/worker.
PDFMATHTRANSLATE_WORKING_DIR=
# Keep the translator's own layout output under
# outputs/<document>/extraction/debug. Hundreds of megabytes per paper.
PDFMATHTRANSLATE_DEBUG=false
# Output mode. "mono" publishes the translated PDF only; "dual" additionally
# publishes a bilingual PDF beside it. The translated PDF is always the
# watermark-free monolingual one.
PDFMATHTRANSLATE_OUTPUT_MODE=mono
# Paragraphs translated concurrently. Translation is the only slow stage of a
# run and its wall time scales with this; raise it for a provider that allows
# more concurrent requests, lower it if the provider rate-limits.
PDFMATHTRANSLATE_QPS=4

# Queue
REDIS_URL=redis://localhost:6379/0

# Vision-model adversarial check (Phase D). deepseek-flash accepts image input.
VISION_MODEL=deepseek-flash
VISION_CHECK_ENABLED=false
VISION_CHECK_MODE=auto
VISION_CHECK_MAX_PAGES=8

# Frontend
VITE_BACKEND_URL=http://localhost:8000
